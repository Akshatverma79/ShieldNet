# ─── ShieldNet Environment Configuration ────────────────────────
# Copy this file to .env and adjust as needed.
# All values below are the defaults used if not set.

# Application
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# Database (SQLite default; switch to PostgreSQL for production)
# DATABASE_URL=sqlite:///backend/shieldnet.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/shieldnet

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Simulation interval (seconds between synthetic events)
SIMULATION_INTERVAL=1.0
